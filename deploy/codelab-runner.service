# systemd unit of the CodeLab runner. Copy to /etc/systemd/system/ and run: systemctl enable --now codelab-runner
# The settings are in /etc/codelab-runner.env (see deploy/codelab-runner.env.example), readable only by root and codelab.
[Unit]
Description=CodeLab runner (interactive programs for the CodeLab plugins of Moodle)
After=network.target mariadb.service

[Service]
User=codelab
Group=codelab
WorkingDirectory=/opt/codelab-runner/app
EnvironmentFile=/etc/codelab-runner.env
ExecStart=/usr/bin/node server.js
Restart=on-failure
# The webhook (POST /deploy) ends the process with 75 after an update: a normal end, restart at once.
SuccessExitStatus=75
RestartForceExitStatus=75
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
