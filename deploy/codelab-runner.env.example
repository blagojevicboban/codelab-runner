# Settings of the CodeLab runner: copy to /etc/codelab-runner.env, then
#   sudo chown root:root /etc/codelab-runner.env && sudo chmod 600 /etc/codelab-runner.env
# (root only: systemd reads it, and the students' programs, which run as the same user as the server, must not.)
# The same secret goes into the settings of tiny_codelab in Moodle (Secret of the interactive server).
CODELAB_SECRET=change-me-openssl-rand-hex-24
CODELAB_HOST=127.0.0.1
CODELAB_PORT=8090
# Only pages of this Moodle may open sessions.
CODELAB_ORIGINS=https://moodle.example.org
# Counts every process and thread of the user codelab: a JVM or Mono has 20 to 30 threads, so about 40 per session.
# 0 (off) relies on TasksMax of the systemd unit.
CODELAB_NPROC=1200
# Sites with a secret of their own (site id from the tiny_codelab settings page): site:secret, comma separated.
CODELAB_SECRETS=
# Runs for grading (POST /run) at once, beside the sessions.
CODELAB_BATCH_MAX=10
# SQL (optional): the MariaDB user made by deploy/mariadb-admin.sh.
CODELAB_MYSQL_USER=codelab_admin
CODELAB_MYSQL_PASSWORD=
CODELAB_MYSQL_SOCKET=/run/mysqld/mysqld.sock
# Updates from GitHub (optional): the secret of the repository's webhook (POST /deploy, push events, application/json).
# Only signed release tags (v1.2.3) are deployed; see Updates from GitHub in README.md.
CODELAB_DEPLOY_SECRET=
