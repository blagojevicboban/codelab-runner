<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>CodeLab.Roslyn</AssemblyName>
    <RootNamespace>CodeLab.Roslyn</RootNamespace>
    <InvariantGlobalization>false</InvariantGlobalization>
    <TieredCompilation>true</TieredCompilation>
    <ServerGarbageCollector>false</ServerGarbageCollector>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <!-- The languages of Roslyn's own messages: the satellite assemblies of these are published. -->
    <SatelliteResourceLanguages>cs;de;es;fr;it;ja;ko;pl;pt-BR;ru;tr;zh-Hans;zh-Hant</SatelliteResourceLanguages>
    <!-- packages.lock.json pins every package with its hash; the deploy on the server restores in locked mode. -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Features" Version="4.11.0" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net472" Version="1.0.3"
                      GeneratePathProperty="true" PrivateAssets="all" ExcludeAssets="all" />
  </ItemGroup>

  <!-- The reference assemblies the programs are checked against, with their XML documentation (the tooltips). -->
  <ItemGroup>
    <RefAssembly Include="mscorlib;System;System.Core;System.Xml;System.Xml.Linq;System.Data;System.Numerics" />
    <None Include="@(RefAssembly->'$(PkgMicrosoft_NETFramework_ReferenceAssemblies_net472)/build/.NETFramework/v4.7.2/%(Identity).dll')"
          Link="refs/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="@(RefAssembly->'$(PkgMicrosoft_NETFramework_ReferenceAssemblies_net472)/build/.NETFramework/v4.7.2/%(Identity).xml')"
          Link="refs/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
